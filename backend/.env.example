# ============================================
# EcoClean Store — Variables de Entorno
# ============================================
# Copiar a .env y ajustar valores

# Puerto del backend
PORT=4000

# Base de datos (opción A: variables individuales)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoclean
DB_USER=ecoclean
DB_PASSWORD=ecoclean123

# Base de datos (opción B: URL completa — usada en Render/Railway)
# Si DATABASE_URL está definida, tiene prioridad sobre las variables individuales
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_SSL=false

# JWT
JWT_SECRET=cambiar_por_una_clave_segura_larga_y_aleatoria

# Entorno
NODE_ENV=development

# CORS — URL(s) del frontend (separadas por coma)
# En producción, poner la URL real del frontend desplegado
# Ejemplo: FRONTEND_URL=https://miapp.railway.app
FRONTEND_URL=http://localhost:3000
